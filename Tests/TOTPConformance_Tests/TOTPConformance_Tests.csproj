<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>cloud.charging.open.TOTP.Conformance.tests</RootNamespace>
    <AssemblyName>cloud.charging.open.TOTP.Conformance.tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>

  <!-- The canonical vector files: the specification's normative annex
       (libs/specification submodule), shared with the TypeScript harness. -->
  <ItemGroup>
    <None Include="..\..\libs\specification\TimeBasedOneTimePasswords\test-vectors\*.json"
          Link="TestVectors\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
